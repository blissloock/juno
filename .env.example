# Copia este archivo como ".env" (sin el ".example") y llena tus propios
# valores. El archivo ".env" real NUNCA debe subirse a git: agrégalo a
# .gitignore.

POSTGRES_DB=monitoreo_db
POSTGRES_USER=admin_rust
POSTGRES_PASSWORD=cambia_esto_por_una_contraseña_fuerte

# Cuenta de Gmail para el envío de alertas (usar una "contraseña de
# aplicación" de Google, no la contraseña normal de la cuenta).
GMAIL_USER=tu_correo_de_pruebas@gmail.com
GMAIL_PASS=tu_contrasena_de_aplicacion

# Secreto para firmar los JWT de sesión. Genera uno fuerte y aleatorio con:
#   openssl rand -hex 32
# NUNCA reutilicen el mismo secreto entre entornos (dev/producción), y
# nunca lo suban a git.
JWT_SECRET=reemplaza_esto_con_el_resultado_de_openssl_rand_hex_32

# Dominio/origen desde el que el frontend hace las peticiones (CORS).
# En desarrollo local, si Nginx sirve el frontend en el puerto 80:
FRONTEND_ORIGIN=http://localhost:80

# Umbral de entropía (bits) para disparar una alerta de posible escaneo/
# anomalía de red. Default si se omite: 3.5
NETFLOW_ENTROPIA_UMBRAL=3.5
NETFLOW_ENTROPIA_INTERVALO_SEGUNDOS=60

# A quién mandar las alertas críticas por correo. Si se omite, se manda a
# la misma cuenta de GMAIL_USER.
ALERT_EMAIL_TO=tu_correo_de_pruebas@gmail.com
